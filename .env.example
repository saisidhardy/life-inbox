# OpenAI API configuration (optional in dev, uses deterministic fallback if unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Database URL (SQLite file path)
DATABASE_URL=sqlite:///data/life_inbox.db

# Authentication: Single-user bearer/header token for /api/* routes (leave blank to disable in local dev)
APP_TOKEN=

# Rate limiting & cost control for /api/analyze
ANALYZE_RATE_LIMIT_PER_MINUTE=5
ANALYZE_DAILY_CAP=50
